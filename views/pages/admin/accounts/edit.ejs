<nav class="page-breadcrumb" aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/admin/accounts">Accounts</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit</li>
  </ol>
</nav>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Edit account</h4>
        <form action="/admin/accounts/<%= account.id %>" method="post">
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input id="name" name="name" class="form-control" type="text" required maxlength="64" value="<%= values.name %>">
          </div>
          <div class="mb-3">
            <label for="brandName" class="form-label">Brand name</label>
            <input id="brandName" name="brandName" class="form-control" type="text" required maxlength="64" value="<%= values.brandName %>">
            <div class="form-text">Used as <code>Your {brandName} code: {code}</code></div>
          </div>
          <div class="mb-3">
            <label for="otpLength" class="form-label">OTP length</label>
            <input id="otpLength" name="otpLength" class="form-control" type="number" min="4" max="8" step="1" value="<%= values.otpLength %>">
          </div>
          <div class="mb-3 form-check">
            <input id="enabled" name="enabled" class="form-check-input" type="checkbox" value="on"<%= values.enabled ? " checked" : "" %>>
            <label for="enabled" class="form-check-label">Enabled</label>
          </div>
          <p class="text-muted small">Key prefix: <code><%= account.apiKeyPrefix %>…</code> · SMS remaining: <strong><%= account.smsQuota %></strong></p>
          <button class="btn btn-primary" type="submit">Save</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card mb-3">
      <div class="card-body">
        <h4 class="card-title">Add SMS</h4>
        <p class="text-muted">Adds to remaining quota. Does not set an absolute total.</p>
        <form action="/admin/accounts/<%= account.id %>/topup" method="post" class="d-flex gap-2 align-items-end">
          <div>
            <label for="amount" class="form-label">Amount</label>
            <input id="amount" name="amount" class="form-control" type="number" min="1" step="1" required>
          </div>
          <button class="btn btn-primary" type="submit">Add SMS</button>
        </form>
      </div>
    </div>
    <div class="card mb-3">
      <div class="card-body">
        <h4 class="card-title">API key</h4>
        <p class="text-muted">Regenerating invalidates the current key immediately.</p>
        <form action="/admin/accounts/<%= account.id %>/regenerate-key" method="post">
          <button class="btn btn-outline-danger" type="submit" onclick="return confirm('Are you sure? This will invalidate the current API key.');">Regenerate API key</button>
        </form>
      </div>
    </div>
    <% if (account.enabled) { %>
      <div class="card">
        <div class="card-body">
          <h4 class="card-title">Disable</h4>
          <p class="text-muted">A disabled account cannot send OTPs.</p>
          <form action="/admin/accounts/<%= account.id %>/disable" method="post">
            <button class="btn btn-outline-secondary" type="submit" onclick="return confirm('Disable this account? It will not be able to send OTPs.');">Disable account</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>
