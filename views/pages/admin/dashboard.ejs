      <div class="card-body">
        <h2 class="h5">Accounts</h2>
        <p class="text-muted">API keys, SMS quota, and OTP settings.</p>
        <a class="btn btn-primary" href="/admin/accounts">View accounts</a>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
