# Node HTTP + WebSocket listen port (default 3000).
# For the sample Nginx proxy to 127.0.0.1:6050, set PORT=6050.
PORT=3000

# Bind address. 0.0.0.0 = all interfaces (needed for phone-on-LAN testing).
# Use 127.0.0.1 to keep the server local-only.
HOST=0.0.0.0

# WebSocket device REGISTER only (REGISTER.apiKey).
# NOT used for HTTP POST /api/send-otp. Send-otp uses a per-account
# x-api-key created in the admin panel (/admin/accounts).
# Required in production. Use a strong value; never commit real secrets.
API_KEY=dev-api-key

# Max successful SMS per device (sentCount after SMS_SENT).
MAX_SMS_PER_DEVICE=500

# Empty or * = open CORS; or comma-separated origins.
CORS_ORIGIN=*

# Max in-memory queue size before rejecting new jobs.
MAX_QUEUE_SIZE=1000

# SQLite file for API accounts and SMS quotas (survives restart).
# Relative paths are resolved from the sms-gateway directory.
# Queue and online devices stay in memory and are lost on restart.
SQLITE_PATH=data/gateway.sqlite

# Cookie signing secret for the admin session (cookie name admin.sid).
# Local default is dev-session-secret if unset. LOCAL ONLY — set a
# strong unique value in production (process will refuse to start without it).
SESSION_SECRET=dev-session-secret

# Single-operator admin login at /login.
# Defaults (admin / admin) apply only when NODE_ENV is not production.
# ADMIN_PASSWORD=admin is LOCAL ONLY. In production, ADMIN_PASSWORD must
# be set to a non-default value or the process will refuse to start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# development (default if unset) | production.
# In production, session.cookie.secure is true (HTTPS required) and
# default SESSION_SECRET / ADMIN_PASSWORD=admin are rejected at startup.
# NODE_ENV=development
